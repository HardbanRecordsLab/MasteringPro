# ============================================================================
#  Root .env — consumed by docker-compose.yml on the VPS ONLY.
#  Copy to  .env  and fill in.  (The frontend uses .env.local / Vercel envs.)
# ============================================================================

# Public domain that will serve the API (DNS A record must point here first).
API_DOMAIN=api.masterpro.yourdomain.com

# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@yourdomain.com
