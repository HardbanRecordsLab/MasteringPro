# ============================================================================
#  MasteringPro API — backend environment
#  Copy to  server/.env  and fill in AI_API_KEY.
# ============================================================================

# ── HTTP ────────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# CORS. Set to your frontend URL(s) in production, comma-separated. "*" = any.
# Account features need real origins here (browsers block cookies with "*").
# e.g. ALLOWED_ORIGINS=https://masteringpro.hardbanrecordslab.online,https://masteringpro.vercel.app
ALLOWED_ORIGINS=*

# ── Database (optional) ─────────────────────────────────────────────────────
# Postgres for accounts / saved projects / presets. Leave BLANK to run the API
# as an AI proxy only (no accounts). On the HBRL VPS this points at the shared
# hbrl-postgres over the `hbrl-db` Docker network and comes from Infisical:
#   DATABASE_URL=postgresql://hbrl_admin:PASSWORD@hbrl-postgres:5432/masteringpro
# Local dev with your own Postgres:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/masteringpro
DATABASE_URL=

# Session cookie lifetime (days) and Secure flag (auto-on when NODE_ENV=production).
SESSION_DAYS=30
COOKIE_SECURE=

# ── AI provider (OpenAI-compatible) ─────────────────────────────────────────
# OpenRouter by default — get a key at https://openrouter.ai/keys
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=

# Primary model — cheap paid model (fractions of a cent per master).
AI_MODEL=deepseek/deepseek-chat-v3-0324

# Automatic fallback chain (OpenRouter tries these in order when the primary is
# down / rate-limited / out of credits). Comma-separated, MAX 3 entries. Leave
# BLANK to use the built-in default (deepseek-chat-v3-0324, llama-3.3-70b,
# gemini-2.5-flash-lite). Verify names + pricing at https://openrouter.ai/models
AI_MODELS=

# OpenRouter data policy: deny = only providers that do not store or train on
# prompts (user messages). Free ":free" models have no such providers, so they
# fail under deny — keep the model list paid. Empty = provider default.
AI_DATA_COLLECTION=deny

# Best price / quality picks if you want the primary to be a paid model:
#   AI_MODEL=google/gemini-2.5-flash-lite     # cheapest, fast, solid
#   AI_MODEL=google/gemini-2.5-flash          # a bit pricier, noticeably better
#   AI_MODEL=openai/gpt-4o-mini               # reliable strict-JSON

# Ask the model for strict JSON output. Set to false only if your model 400s on it.
AI_JSON_MODE=true

# Shown on your OpenRouter dashboard (optional)
AI_APP_URL=https://masteringpro.hardbanrecordslab.online
AI_APP_TITLE=MasteringPro
AI_TIMEOUT_MS=45000

# ── Abuse protection (in-memory, per client IP) ─────────────────────────────
RATE_LIMIT_MASTERING_MAX=20
RATE_LIMIT_COPILOT_MAX=60
RATE_LIMIT_WINDOW_MIN=60
# Behind nginx/Caddy this must stay true so the real client IP is used.
TRUST_PROXY=true

# Max request body (bytes). 256 KiB default — metrics payloads are small.
MAX_BODY_BYTES=262144

# ── Billing (one service level; credits = tracks; used only once DATABASE_URL is set) ──
# 1 credit = 1 track exported as a master (same track free again for 3 days). Three one-time packs of the SAME service:
# 1 track, 3 tracks, 10 tracks, album (16). No subscription; credits never expire. Prices live in Stripe (one-time Price in USD each — USD only).
# Same Stripe account as Metadata Engine / CMLP / HRL Books, but its OWN webhook endpoint:
#   https://api.masteringpro.hardbanrecordslab.online/api/billing/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, charge.refunded, charge.dispute.created
# Step-by-step: HRL Handbook, chapter 12 (Podłączenie Stripe).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PACK_SINGLE=price_...
STRIPE_PRICE_PACK_THREE=price_...
STRIPE_PRICE_PACK_TEN=price_...
STRIPE_PRICE_PACK_ALBUM=price_...
# STRIPE_SUCCESS_URL=https://masteringpro.hardbanrecordslab.online/?billing=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://masteringpro.hardbanrecordslab.online/?billing=cancelled

# Charging for exports. Leave OFF until the packs can really be bought (Stripe connected + tested), then set true.
# While off, exporting is not charged at all.
EXPORT_METERING=false
# Operator accounts: full access, never charged. Comma-separated e-mails.
ADMIN_EMAILS=
# AI Mastering / Copilot are included in the track price; per-account daily cap on calls (they cost real money).
AI_DAILY_PER_USER=200

# Master Passport signing key: base64 of a random 32-byte Ed25519 seed (keep a backup — losing it means old
# passports can no longer be verified). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSPORT_PRIVATE_KEY=
