# ============================================================================
#  MasteringPro API — backend environment
#  Copy to  server/.env  and fill in AI_API_KEY.
# ============================================================================

# ── HTTP ────────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# CORS. Set to your frontend URL(s) in production, comma-separated. "*" = any.
# Account features need real origins here (browsers block cookies with "*").
# e.g. ALLOWED_ORIGINS=https://masteringpro.hardbanrecordslab.online,https://masteringpro.vercel.app
ALLOWED_ORIGINS=*

# ── Database (optional) ─────────────────────────────────────────────────────
# Postgres for accounts / saved projects / presets. Leave BLANK to run the API
# as an AI proxy only (no accounts). On the HBRL VPS this points at the shared
# hbrl-postgres over the `hbrl-db` Docker network and comes from Infisical:
#   DATABASE_URL=postgresql://hbrl_admin:PASSWORD@hbrl-postgres:5432/masteringpro
# Local dev with your own Postgres:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/masteringpro
DATABASE_URL=

# Session cookie lifetime (days) and Secure flag (auto-on when NODE_ENV=production).
SESSION_DAYS=30
COOKIE_SECURE=

# ── AI provider (OpenAI-compatible) ─────────────────────────────────────────
# OpenRouter by default — get a key at https://openrouter.ai/keys
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=

# Primary model. Default is a strong FREE model — no spend until you change it.
AI_MODEL=deepseek/deepseek-chat-v3-0324:free

# Automatic fallback chain (OpenRouter tries these in order when the primary is
# down / rate-limited / out of credits). Comma-separated, MAX 3 entries. Leave
# BLANK to use the built-in default: free first, then the cheapest capable paid
# model (Gemini 2.5 Flash-Lite — fractions of a cent per master).
# Verify current names + pricing at https://openrouter.ai/models
AI_MODELS=

# Best price / quality picks if you want the primary to be a paid model:
#   AI_MODEL=google/gemini-2.5-flash-lite     # cheapest, fast, solid
#   AI_MODEL=google/gemini-2.5-flash          # a bit pricier, noticeably better
#   AI_MODEL=openai/gpt-4o-mini               # reliable strict-JSON
#   AI_MODEL=deepseek/deepseek-chat-v3-0324   # paid tier of the free default

# Ask the model for strict JSON output. Set to false only if your model 400s on it.
AI_JSON_MODE=true

# Shown on your OpenRouter dashboard (optional)
AI_APP_URL=https://masteringpro.hardbanrecordslab.online
AI_APP_TITLE=MasteringPro
AI_TIMEOUT_MS=45000

# ── Abuse protection (in-memory, per client IP) ─────────────────────────────
RATE_LIMIT_MASTERING_MAX=20
RATE_LIMIT_COPILOT_MAX=60
RATE_LIMIT_WINDOW_MIN=60
# Behind nginx/Caddy this must stay true so the real client IP is used.
TRUST_PROXY=true

# Max request body (bytes). 256 KiB default — metrics payloads are small.
MAX_BODY_BYTES=262144
